# Image mode guest for a reboot capture: the bootc base plus the capture
# script, which cloud-init installs on the other platforms.
ARG BASE
FROM ${BASE}

COPY petit-capture.sh /usr/libexec/petit-capture
COPY petit-capture.service /usr/lib/systemd/system/petit-capture.service
RUN chmod 0755 /usr/libexec/petit-capture \
    && systemctl enable petit-capture.service \
    && echo host01 >/etc/hostname \
    && mkdir -p /usr/lib/tmpfiles.d \
    && echo 'd /var/log/journal 2755 root systemd-journal -' >/usr/lib/tmpfiles.d/petit-journal.conf
